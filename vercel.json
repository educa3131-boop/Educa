{
    "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "env": {
    "NODE_ENV": "production",
    "DATA_DIR": "/tmp",
    "COOKIE_SECURE": "true",
    "EXPOSE_DEV_LINKS": "false"
  }
}
