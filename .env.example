# EDUCA — variáveis de ambiente
# Copia para .env e preenche os valores reais. Nunca comittes segredos.

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DATA_DIR=./data

# Proprietário inicial (criado apenas na primeira execução)
ADMIN_EMAIL=admin@educa.mz
# Se ficar vazio, é gerada uma palavra-passe aleatória na primeira execução
# e mostrada no log do servidor. Define uma palavra-passe forte em produção.
ADMIN_PASSWORD=

# Cookies e sessão
COOKIE_SECURE=false
EXPOSE_DEV_LINKS=true

# Email transaccional (opcional). Sem RESEND_API_KEY, os links de verificação
# e reposição são devolvidos na resposta da API para uso em desenvolvimento.
RESEND_API_KEY=
MAIL_FROM="EDUCA <no-reply@educa.mz>"

# Aulas ao vivo: Jitsi público por omissão. Para salas com token assinado,
# configura as credenciais JaaS (8x8). Sem elas, a plataforma usa meet.jit.si.
JITSI_JAAS_DOMAIN=
JITSI_JAAS_KID=
JITSI_JAAS_PRIVATE_KEY=
JITSI_JAAS_ISS=educa
JITSI_JAAS_SUB=*
